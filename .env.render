# ============================================
# Turathi — Render.com Production Environment
# ============================================
# Copy these values into Render Dashboard → Environment Variables

APP_NAME=Turathi
APP_ENV=production
APP_KEY=base64:CHANGE_ME_RUN_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://turathi-api.onrender.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=fr

# Database — Auto-filled by Render from PostgreSQL service
DB_CONNECTION=pgsql
DB_HOST=turathi-db.internal(or from Render dashboard)
DB_PORT=5432
DB_DATABASE=turathi
DB_USERNAME=turathi_user
DB_PASSWORD=from_render_dashboard

# Session / Cache / Queue — Use database driver
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# Logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Storage — Use local disk (Render has persistent disk on free tier)
FILESYSTEM_DISK=local

# reCAPTCHA
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Mail — Log driver (no email config needed for demo)
MAIL_MAILER=log

# BROADCAST
BROADCAST_CONNECTION=log
